PORT=3333
API_PREFIX=api
CORS_ORIGIN=*

# Primary Database (MySQL via Docker for tracking refund cases)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=localuser
DB_PASSWORD=localpassword
DB_DATABASE=rox_refund_management

# Source Database (Production rox_app for verifying complaints)
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=3306
SOURCE_DB_USERNAME=root
SOURCE_DB_PASSWORD=secret
SOURCE_DB_DATABASE=rox_app

# Redis / Bull Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# rox-notifications-server (customer push notifications) — default 3005
NOTIFICATIONS_SERVICE_URL=http://localhost:3005

# Auth / JWT
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRES_IN=8h

# ─── Easypaisa Refund Configuration ───────────────────────────────────────────
EASYPAISA_STORE_ID=your_easypaisa_store_id
EASYPAISA_CREDENTIALS=your_easypaisa_credentials_base64
EASYPAISA_AUTH_TOKEN=your_easypaisa_auth_token_jwt
EASYPAISA_REFUND_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"
EASYPAISA_REFUND_API_URL=https://easypay.easypaisa.com.pk/easypay-service/rest/ReversalBusinessRestService/v1/reversalBusiness
EASYPAISA_ACCOUNT_NUM=your_easypaisa_account_number
EASYPAISA_INQUIRY_API_URL=https://easypay.easypaisa.com.pk/easypay-service/rest/v4/inquire-transaction

# ─── JazzCash Configuration ────────────────────────────────────────────────────
JAZZCASH_MERCHANT_ID=your_jazzcash_merchant_id
JAZZCASH_PASSWORD=your_jazzcash_password
JAZZCASH_MERCHANT_MPIN=your_jazzcash_mpin
JAZZCASH_SALT=your_jazzcash_salt
JAZZCASH_CURRENCY=PKR
JAZZCASH_REFUND_API_URL=https://onlinepayments.jazzcash.com.pk/payment-orchestrator/api/v1/rest/payments/m-wallet/refund
JAZZCASH_CARD_REFUND_API_URL=https://onlinepayments.jazzcash.com.pk/payment-orchestrator/api/v1/rest/payments/mpgs/authorize/refund
